# Appwrite server credentials (never prefix the API key with NEXT_PUBLIC_)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_VECTOR_DATABASE_ID=founder-memory
APPWRITE_VECTOR_COLLECTION_ID=knowledge
